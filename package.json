{
  "name": "pyrovue-runner",
  "version": "0.1.0",
  "description": "Run any Git repository in a disposable Docker box with one command. No config file needed.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "pyrovue-run": "dist/cli.js"
  },
  "files": ["dist", "box", "README.md", "LICENSE"],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "esbuild src/cli.ts --bundle --platform=node --format=esm --target=node20 --packages=external --banner:js=\"#!/usr/bin/env node\" --outfile=dist/cli.js",
    "box:build": "docker build -t pyrovue-runner/box:1 box",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build"
  },
  "keywords": ["docker", "sandbox", "dev-environment", "git", "github", "gitlab", "preview", "gvisor", "cli"],
  "dependencies": {
    "dockerode": "^4.0.7"
  },
  "devDependencies": {
    "@types/dockerode": "^3.3.38",
    "@types/node": "^22.15.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  }
}
